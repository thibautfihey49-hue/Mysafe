<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F0F4F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <org.osmdroid.views.MapView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:background="#E8E8E8"/>

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="En attente..."
            android:padding="12dp"
            android:background="#E3F2FD"
            android:textColor="#1565C0"
            android:layout_marginVertical="8dp"/>

        <EditText
            android:id="@+id/target_phone_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="📞 Numéro cible"
            android:inputType="phone"
            android:padding="12dp"
            android:layout_marginVertical="4dp"/>

        <EditText
            android:id="@+id/my_phone_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="📱 Mon numéro"
            android:inputType="phone"
            android:padding="12dp"
            android:layout_marginVertical="4dp"/>

        <Button
            android:id="@+id/toggle_tracking_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▶️ DÉMARRER LE SUIVI"
            android:background="#4CAF50"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:layout_marginVertical="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginVertical="4dp">

            <Button
                android:id="@+id/stream_video_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📹 Caméra"
                android:background="#2196F3"
                android:textColor="#FFFFFF"
                android:padding="10dp"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/stream_audio_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📍 Position"
                android:background="#FF9800"
                android:textColor="#FFFFFF"
                android:padding="10dp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btn_float_map"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📌 Carte flottante"
            android:background="#9C27B0"
            android:textColor="#FFFFFF"
            android:padding="10dp"
            android:layout_marginVertical="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📋 Historique"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btn_clear_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗑️ Effacer"
                android:background="#FF5722"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"/>
        </LinearLayout>

        <ListView
            android:id="@+id/history_list_view"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="8dp"
            android:divider="#E0E0E0"
            android:dividerHeight="1dp"/>

    </LinearLayout>
</ScrollView>
