<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FFFFFF">
    <org.osmdroid.views.MapView android:id="@+id/float_map"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#E8E8E8"/>
    <Button android:id="@+id/btn_close_float"
        android:layout_width="28dp" android:layout_height="28dp" android:text="✖"
        android:textSize="12sp" android:padding="0dp" android:layout_gravity="top|right"
        android:layout_margin="4dp" android:background="#FF0000" android:textColor="#FFFFFF"/>
</FrameLayout>
